rules_version = '2';
// MODELO DE CONTROLE DE ACESSO A ANEXOS (postura deliberada — não é um gap esquecido):
//
// Downloads diretos pelo SDK são bloqueados. A leitura passa por
// `/api/attachments`, que revalida papel, território, OS e a referência do arquivo
// antes de fazer streaming pelo Firebase Admin. Uploads também passam pela API,
// que valida acesso à OS e a assinatura real do arquivo antes de persistir.
//
// ⚠️ POR ISSO TODA REGRA AQUI É `if false`, E NÃO HÁ FUNÇÕES AUXILIARES.
//
// O arquivo já teve seis (`isManager`, `canAttachMessage`, `isValidImage`,
// `isValidPdf`, `isValidAttachmentDocument`, `isAuthenticated`) — 40 das 102 linhas,
// e NENHUMA era chamada, porque não há um único `allow` que dependa de condição. O
// compilador reclamava das seis por estarem sem uso e, em cascata, de cada `request`
// dentro delas ("Invalid variable name"), já que fora de um `match` não há o que
// ligar. Eram ~30 avisos em toda compilação, todos sem defeito por trás — o tipo de
// ruído que ensina a ignorar aviso.
//
// Se um dia o acesso direto pelo SDK for habilitado, as regras de validação moram
// hoje em `api/_lib/attachmentAccess.js` e `api/_lib/attachments.js`, que é onde
// elas de fato rodam. Reescrevê-las aqui a partir dali é mais honesto do que manter
// uma cópia morta que ninguém compara com a viva.
service firebase.storage {
  match /b/{bucket}/o {
    // O upload/download público não é permitido. Tudo passa pela API.

    match /attachments/tickets/images/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/pdfs/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/contracts/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/quotes/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/payments/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/measurements/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/messages/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /attachments/tickets/inbound/{ticketId}/{fileName=**} {
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
