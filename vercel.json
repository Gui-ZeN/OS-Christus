{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/email/send",
      "destination": "/api/mail?route=send"
    },
    {
      "source": "/api/email/health",
      "destination": "/api/mail?route=health"
    },
    {
      "source": "/api/email/outbox-worker",
      "destination": "/api/mail?route=outbox-worker"
    },
    {
      "source": "/api/email/gmail-sync",
      "destination": "/api/mail?route=gmail-sync"
    },
    {
      "source": "/api/email/gmail-watch",
      "destination": "/api/mail?route=gmail-watch"
    },
    {
      "source": "/api/email/gmail-push",
      "destination": "/api/mail?route=gmail-push"
    },
    {
      "source": "/api/email/inbound",
      "destination": "/api/mail?route=inbound"
    },
    {
      "source": "/api/firestore-backfill",
      "destination": "/api/admin-tools?route=backfill"
    },
