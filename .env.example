# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública do app (Vercel em produção). Usada em links de e-mail
# (convite/reset de senha, CTA "Ver atualização"). O código lê APP_BASE_URL e,
# como fallback, PUBLIC_APP_URL. (APP_URL sozinha não é lida pelo código.)
APP_BASE_URL="https://serv3.vercel.app"
PUBLIC_APP_URL="https://serv3.vercel.app"

# Destinatário das notificações internas (cópia de novas OS, etc.).
TICKET_NOTIFICATION_EMAIL="napa14@christus.com.br"

# Segredo do cron de sincronização do Gmail (.github/workflows/gmail-sync.yml).
CRON_SECRET="troque-este-segredo"

# Firebase Infra Setup
GOOGLE_APPLICATION_CREDENTIALS=".secrets/firebase-admin.json"
# Em produção (Vercel), usar JSON completo da service account
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",...}"
# Alternativa recomendada: service account em base64 (evita erro de escape no painel)
FIREBASE_SERVICE_ACCOUNT_B64=""
# ⚠️ O PROJETO DO FIREBASE É `os-christus`. O `serv3` que sobra em APP_BASE_URL,
# PUBLIC_APP_URL e FIREBASE_CORS_ORIGINS é o domínio da VERCEL e está CERTO — são
# duas coisas diferentes com o mesmo nome antigo, e já custou tempo: URLs de
# workflow foram acusadas de quebradas sem estarem.
FIREBASE_PROJECT_ID="os-christus"
FIREBASE_STORAGE_BUCKET="os-christus-attachments"
FIREBASE_ALLOW_BUCKET_CREATE="false"
FIREBASE_BUCKET_LOCATION="us-central1"
FIREBASE_CORS_ORIGINS="http://localhost:3000,https://serv3.vercel.app"
FIREBASE_SKIP_STORAGE="false"
FIREBASE_SKIP_FIRESTORE="false"

# Firebase Web App (Auth cliente)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="os-christus"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Signed URL helper
STORAGE_SIGN_MODE="upload"
TICKET_ID="OS-0050"
FILE_NAME="orcamento.pdf"
FILE_MIME_TYPE="application/pdf"
SIGNED_URL_EXPIRES_MIN="15"
STORAGE_OBJECT_PATH=""

# Envio de e-mail: Gmail é o único provedor.


# Gmail API — envio e recebimento
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_REDIRECT_URI="https://developers.google.com/oauthplayground"
GMAIL_FROM_EMAIL="napa14@christus.com.br"
# Opcional: "De:" com domínio próprio mantendo o inbound na caixa atual.
# GMAIL_FROM_EMAIL vira o remetente (precisa ser alias verificado "Enviar como"
# na conta do OAuth); GMAIL_REPLY_TO_EMAIL faz a resposta voltar para a caixa que
# o sistema vigia. Deixe GMAIL_REPLY_TO_EMAIL vazio para não enviar Reply-To.
# Nome exibido no "De:" — sai como `Serv3 <napa01@christus.com.br>`. Sem ele o
# padrao "Serv3" vale; deixe vazio para enviar so o endereco, como era antes.
GMAIL_FROM_NAME="Serv3"
GMAIL_REPLY_TO_EMAIL=""
# CC fixo em toda conversa com o solicitante (redundância do Reply-To: garante que
# "responder a todos" também chegue à caixa vigiada). Normalmente = a caixa do inbound.
TICKET_ALWAYS_CC_EMAIL=""
GMAIL_SYNC_SECRET="troque-este-segredo"
# ⚠️ NÃO VERIFICADO em 31/08: a chave de serviço não tem permissão no Pub/Sub, então
# não deu para confirmar em qual projeto GCP o tópico vive. Ficou como estava — o
# tópico do Gmail pode legitimamente ter continuado no projeto antigo. Confirme no
# console antes de copiar este valor.
GMAIL_PUBSUB_TOPIC_NAME="projects/serv3/topics/serv3-gmail"
GMAIL_PUSH_SECRET="troque-este-segredo"

